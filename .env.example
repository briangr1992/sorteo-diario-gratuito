NODE_ENV=development
PUBLIC_ORIGIN=http://localhost:10000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sorteo
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Email login verification (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
RESEND_API_KEY=

# OAuth credentials: store secrets in Render Environment, never commit them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=


# Google Ad Manager: use Ad Manager inventory paths and numeric network code.
# Example unit path format: /1234567/site/home_side
GAM_NETWORK_CODE=
GAM_AD_UNIT_SIDE=
GAM_AD_UNIT_MOBILE=
GAM_AD_UNIT_CONTENT=
# Production ads stay off until a CMP exposes the IAB TCF API.
GAM_REQUIRE_CMP=true
# Secret bearer key for your scheduled Ad Manager daily revenue report import.
GAM_REVENUE_IMPORT_KEY=
